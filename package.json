{
  "name": "rivalry90",
  "version": "0.1.0",
  "private": true,
  "description": "RIVALRY 90 — Next-Generation 3D Football Gaming Website",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css,mjs}\" \"tests/**/*.{js,jsx}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,mjs}\" \"tests/**/*.{js,jsx}\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:validate": "node scripts/validate-assets.mjs",
    "db:migrate:dry": "node scripts/migrate-database.mjs",
    "db:seed:dry": "node scripts/seed-database.mjs",
    "db:integrity": "node scripts/check-db-integrity.mjs",
    "db:validate": "npm.cmd run db:migrate:dry && npm.cmd run db:seed:dry && npm.cmd run db:integrity"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "^2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "howler": "^2.2.4",
    "lenis": "^1.3.27",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "next": "^16.4.6",
    "postprocessing": "^6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "gltf-validator": "^2.0.0-dev.3.10",
    "gltfjsx": "^6.5.3",
    "jsdom": "^31.0.0",
    "leva": "^0.10.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "vitest": "^5.1.0"
  }
}

