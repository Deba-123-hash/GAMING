# ==============================================================================
# RIVALRY 90 — Environment Variables Example
# Copy this file to .env.local and fill in real values when integrating services.
# NEVER commit .env or .env.local to version control.
# ==============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase (Auth, PostgreSQL, Storage) — Phases 18-20
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rivalry90-public-assets

# Server-Only Authentication Session Signing Secret (min 32 random chars in production)
AUTH_SESSION_SECRET=

# Phase 22: Optional External Football Data API (football-data.org v4)
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Phase 22: Optional External AI Provider (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Phase 22: Optional Transactional Email Provider (Resend)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@example.com

# Phase 22: Optional External Media & Video Providers
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
YOUTUBE_API_KEY=

# Optional: Feature Flags
NEXT_PUBLIC_ENABLE_3D_DEVTOOLS=false
NEXT_PUBLIC_ENABLE_AUDIO_BY_DEFAULT=false

# Phase 22 / 25: Optional Analytics & Monitoring
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=
